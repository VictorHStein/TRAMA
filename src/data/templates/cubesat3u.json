  "entities": [
    {
      "id": "mission",
      "name": "Missão AmbSat-3U: monitoramento ambiental",
      "category": "mission",
      "step": 1,
      "description": "CubeSat 3U que fotografa áreas de interesse ambiental e recolhe mensagens de sensores remotos (IoT) via LoRa.",
      "short": "AmbSat",
      "parameters": [
        {
          "id": "dry_mass",
          "unit": "kg",
          "name": "Massa seca (soma dos itens)",
          "formula": "sum(total(\"mass\"))",
          "source": "computed"
        },
        {
          "id": "dry_mass_margined",
          "unit": "kg",
          "name": "Massa seca com margens ECSS",
          "formula": "sum(total(\"mass\", \"margin\")) * 1.2",
          "source": "computed"
        },
        {
          "id": "power_all_on",
          "unit": "W",
          "name": "Consumo com tudo ligado",
          "formula": "sum(total(\"power\"))",
          "source": "computed"
        },
        {
          "id": "generation_avg",
          "unit": "W",
          "name": "Geração média por órbita",
          "formula": "eps.power_generation * (1 - mission.eclipse_fraction)",
          "source": "computed"
        },
        {
          "id": "eclipse_fraction",
          "unit": "-",
          "name": "Fração de eclipse (pior caso)",
          "formula": "engine.orbit_eclipse_max_fraction",
          "source": "computed",
          "notes": "Pior caso geométrico (β = 0°) calculado pelo motor a partir de mission.orbit."
        }
      ]
    },
    {
      "id": "obj_imaging",
      "code": "OBJ-1",
      "name": "Fotografar áreas ambientais",
      "category": "objective",
      "parentId": "mission",
      "step": 2,
      "description": "Fotografar áreas de interesse ambiental com GSD de 60 m."
    },
    {
      "id": "obj_iot",
      "code": "OBJ-2",
      "name": "Coletar mensagens IoT",
      "category": "objective",
      "parentId": "mission",
      "step": 2,
      "description": "Coletar mensagens de sensores remotos (IoT) via LoRa."
    },
    {
      "id": "obj_life",
      "code": "OBJ-3",
      "name": "Operar por 3 anos",
      "category": "objective",
      "parentId": "mission",
      "step": 2,
      "description": "Operar por 3 anos em órbita heliossíncrona de 550 km."
    },
    {
      "id": "req_image",
      "name": "Imagens RGB de 60 m",
      "category": "requirement",
      "step": 3,
      "description": "Fotografar áreas de interesse com GSD de até 60 m.",
      "code": "REQ-001",
      "short": "Imagens 60 m",
      "requirement": {
        "text": "O sistema deve adquirir imagens RGB da superfície com GSD menor ou igual a 60 m.",
        "type": "performance",
        "priority": "must",
        "rationale": "Suficiente para detectar queimadas e desmatamento em escala regional.",
        "rule": "camera.gsd_m <= 60",
        "verification": {
          "method": "Test",
          "level": "Subsystem"
        }
      }
    },
    {
      "id": "req_iot",
      "name": "Coleta de mensagens IoT",
      "category": "requirement",
      "step": 3,
      "description": "Receber ao menos 2 000 mensagens LoRa por dia.",
      "code": "REQ-002",
      "short": "IoT 2 000/dia",
      "requirement": {
        "text": "O sistema deve receber e armazenar pelo menos 2 000 mensagens LoRa de sensores remotos por dia.",
        "type": "functional",
        "priority": "must",
        "rule": "lora.messages_per_day >= 2000",
        "verification": {
          "method": "Demonstration",
          "level": "System"
        }
      }
    },
    {
      "id": "req_downlink",
      "name": "Downlink em S-band",
      "category": "requirement",
      "step": 3,
      "description": "Transmitir dados de missão a pelo menos 1 Mbps.",
      "code": "REQ-003",
      "short": "Downlink 1 Mbps",
      "requirement": {
        "text": "O sistema deve transmitir os dados de missão para a estação solo em S-band a pelo menos 1 Mbps.",
        "type": "performance",
        "priority": "must",
        "rule": "sband.data_rate_mbps >= 1",
        "verification": {
          "method": "Test",
          "level": "System"
        }
      }
    },
    {
      "id": "req_power",
      "name": "Autonomia em eclipse",
      "category": "requirement",
      "step": 3,
      "description": "Manter a operação durante o eclipse máximo.",
      "code": "REQ-004",
      "short": "Autonomia",
      "requirement": {
        "text": "O EPS deve manter o satélite em operação durante o eclipse máximo sem exceder a profundidade de descarga da bateria.",
        "type": "functional",
        "priority": "must",
        "rule": "battery.capacity_wh * battery.dod_max * battery.efficiency >= engine.mode_eclipse_w * engine.orbit_eclipse_max_min / 60",
        "verification": {
          "method": "Analysis",
          "level": "Subsystem"
        }
      }
    },
    {
      "id": "req_mass",
      "name": "Massa de 3U",
      "category": "requirement",
      "step": 3,
      "description": "Massa total com margens dentro do envelope 3U.",
      "code": "REQ-005",
      "short": "Massa ≤ 4 kg",
      "requirement": {
        "text": "A massa do satélite no lançamento deve ser menor ou igual a 4,0 kg.",
        "type": "constraint",
        "priority": "must",
        "rationale": "Envelope de massa do deployer 3U.",
        "rule": "engine.budget_mass_total <= 4",
        "verification": {
          "method": "Rule",
          "level": "System"
        }
      }
    },
    {
      "id": "req_deorbit",
      "name": "Reentrada em 25 anos",
      "category": "requirement",
      "step": 3,
      "description": "Cumprir a regra dos 25 anos sem propulsão.",
      "code": "REQ-006",
      "short": "Reentrada",
      "requirement": {
        "text": "O satélite deve reentrar naturalmente em menos de 25 anos após o fim da missão.",
        "type": "constraint",
        "priority": "must",
        "rationale": "Diretriz IADC de mitigação de detritos.",
        "verification": {
          "method": "Analysis",
          "level": "System"
        }
      }
    },
    {
      "id": "func_image",
      "name": "Adquirir imagens",
